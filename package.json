{
  "name": "@tiffany/agent-sdk-creative",
  "version": "1.0.0",
  "description": "Creative-integrator Agent SDK for the RAEN fleet",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "agent": "tsx src/index.ts",
    "surfaces": "tsx src/index.ts --surfaces",
    "audit": "tsx src/index.ts --audit",
    "pipeline": "tsx src/index.ts --pipeline",
    "batch": "tsx src/index.ts --batch",
    "dev": "tsx watch src/index.ts",
    "server": "tsx src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "security": "npm audit --audit-level=high"
  },
  "keywords": ["openrouter", "agent-sdk", "a2a", "x402", "creative", "tiffany", "raen"],
  "author": "Tiffany (Creative-Integrator, RAEN Fleet)",
  "license": "ISC",
  "dependencies": {
    "@openrouter/agent": "^0.11.0",
    "@openrouter/mcp": "^1.1.1",
    "@x402/core": "^2.27.0",
    "express": "^4.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@openrouter/devtools": "^0.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.0",
    "tsx": "^4.7.0",
    "vitest": "^2.0.0"
  }
}
